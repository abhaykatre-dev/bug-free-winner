FLASK_ENV=development
PORT=5000

# Auth mode:
#   "dev"      — accept all requests without Firebase auth token (local only)
#   "firebase" — verify Firebase ID tokens (requires FIREBASE_SERVICE_ACCOUNT_PATH)
AUTH_MODE=dev
FIREBASE_SERVICE_ACCOUNT_PATH=

# ML Models (leave blank to use fallback chain)
# PyTorch MobileNetV2 (preferred — train with: python -m ml.train_mobilenet)
MOBILENET_MODEL_PATH=models/mobilenet_fish.pt
MOBILENET_LABELS_PATH=models/mobilenet_labels.json
# ONNX model (alternative)
ONNX_MODEL_PATH=

# Telegram Bot
TELEGRAM_BOT_TOKEN=

# Translation
# ArgosTranslate is used automatically (offline, no config needed)
# LibreTranslate is used as secondary fallback if URL is set:
LIBRETRANSLATE_URL=

# Storage
SQLITE_PATH=./db/aquaguard.sqlite3

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Logging
LOG_LEVEL=INFO
