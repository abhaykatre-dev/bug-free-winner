FLASK_ENV=development
PORT=5001

# Auth mode (use "dev" for local testing, "firebase" for production)
AUTH_MODE=dev
FIREBASE_SERVICE_ACCOUNT_PATH=

# ML Models
MOBILENET_MODEL_PATH=./models/mobilenet_fish.pt
ONNX_MODEL_PATH=

# External Integrations (Optional)
TELEGRAM_BOT_TOKEN=
FAST2SMS_API_KEY=

# Storage/persistence
SQLITE_PATH=./db/aquadetect.sqlite3

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
