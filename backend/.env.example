FLASK_ENV=development
PORT=5000

# Auth
# - "firebase": verify Firebase ID tokens (requires `FIREBASE_SERVICE_ACCOUNT_PATH`)
# - "dev": accept requests without auth (local only)
AUTH_MODE=dev
FIREBASE_SERVICE_ACCOUNT_PATH=

# ML
ONNX_MODEL_PATH=

# Integrations
TELEGRAM_BOT_TOKEN=
LIBRETRANSLATE_URL=http://localhost:5001

# Storage/persistence
SQLITE_PATH=./db/aquaguard.sqlite3

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

