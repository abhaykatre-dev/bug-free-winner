# ─── Firebase ─────────────────────────────────────────────────────
VITE_FB_API_KEY=your_firebase_api_key
VITE_FB_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FB_PROJECT_ID=your_project_id
VITE_FB_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FB_MESSAGING_SENDER_ID=your_sender_id
VITE_FB_APP_ID=your_app_id
VITE_FB_MEASUREMENT_ID=your_measurement_id

# ─── Backend Flask API ────────────────────────────────────────────
# Use http://localhost:5001/api for local development
# Use https://your-railway-app.up.railway.app/api for production
VITE_FLASK_API_URL=http://localhost:5001/api

# ─── Telegram Bot ─────────────────────────────────────────────────
VITE_TELEGRAM_BOT_USERNAME=your_bot_username
VITE_TELEGRAM_CHAT_ID=your_telegram_chat_id
